{
  "name": "@local/global-pins",
  "version": "1.0.6",
  "private": true,
  "description": "Cross-workspace pinned sessions with manual drag ordering and recent-first sorting for DeepSeek Harness.",
  "repository": {
    "type": "git",
    "url": "https://github.com/tao1020/dsh-global-pins.git"
  },
  "homepage": "https://github.com/tao1020/dsh-global-pins#readme",
  "bugs": "https://github.com/tao1020/dsh-global-pins/issues",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.png",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
